{
  "$schema": "./pipeline_config.schema.json",
  "signal_gen": "AR",
  "event_gen": "predefined",

  "signals": {
    "N": 5,
    "f0": 20,
    "T": 3600,
    "seed": 42,
    "mu_std": [
      [0.5, 0.1],
      [0.0, 0.15],
      [3.0, 0.2],
      [0.0, 0.05],
      [1.0, 0.1]
    ],
    "ar_timescales": [
      [8, 5],
      [3, 3],
      [4, 4],
      [2, 6],
      [5, 3]
    ],
    "ma_params": [[0.3], [0.2], [0.25], [0.15], [0.2]],
    "d": 1
  },

  "predefined": {
    "window_s": 5,
    "min_gap_s": 1.0,
    "event_defs_path": {
      "AR": "../generator/event-defs.json",
      "ARIMA": "../generator/event-defs-arima.json"
    }
  },

  "ml": {
    "mode": "inference_only",
    "model_path": "../models/svm/svm_pretrained.pkl",
    "confidence_threshold": 0.7,
    "svm_config_path": "../../baselines/svm-baseline/config.json",
    "model_meta": {
      "model_id": "svm_v1_ar_trainset_A",
      "trained_on_dataset_id": "AR_predefined_train_A",
      "trained_on_split": "train",
      "trained_by_script": "baselines/svm-baseline/train.py"
    },
    "inference_meta": {
      "inference_dataset_id": "ARIMA_signals_run_2026_08_01",
      "inference_split": "test_or_unseen"
    },
    "leakage_guard": {
      "enabled": true,
      "fail_on_same_dataset_id": true,
      "warn_on_missing_ids": true
    }
  },

  "output": {
    "output_dir": "output"
  }
}
